# Only docs/, emu/, tools/ and the reference PDFs belong to the repository.
# Everything else in this directory stays local: the boot ROM dump, IOS
# images, IDA databases, the Dynamips reference clone, the Python venv.
/*
!/.gitignore
!/docs/
!/emu/
!/tools/
!/*.pdf
!/*.PDF

# Rust build output
target/

# Emulator runtime state (NVRAM / flash files written where it runs)
c1700-nvram.bin
c1700-flash.bin
*.log

# Python
__pycache__/
*.pyc

# Editors and OS
*.swp
*~
.idea/
.vscode/
.DS_Store
