# Only docs/ and emu/ belong to the repository. Everything else in this
# directory stays local: the boot ROM dump, IOS images, manuals and
# datasheets, IDA databases, the Dynamips reference clone, the Python venv.
/*
!/.gitignore
!/docs/
!/emu/

# Rust build output
target/

# Emulator runtime state (NVRAM / flash files written where it runs)
c1700-nvram.bin
c1700-flash.bin
*.log

# Editors and OS
*.swp
*~
.idea/
.vscode/
.DS_Store
